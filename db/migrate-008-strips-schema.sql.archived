
-- Only run migration if strips_old does not already exist
PRAGMA foreign_keys=off;

CREATE TABLE IF NOT EXISTS strips_old_guard (id INTEGER);
-- If strips_old already exists, skip migration
CREATE TEMP TABLE IF NOT EXISTS _skip_migration AS SELECT name FROM sqlite_master WHERE type='table' AND name='strips_old';
INSERT INTO strips_old_guard SELECT 1 WHERE EXISTS (SELECT 1 FROM _skip_migration);
DROP TABLE IF EXISTS _skip_migration;

-- Only run if strips_old_guard is empty (i.e., strips_old does not exist)
INSERT INTO strips_old_guard SELECT 1 WHERE 0;
-- The following block will only run if strips_old does not exist
-- (i.e., strips_old_guard is empty)
--
-- 1. Rename old table
--
-- Only run if strips_old does not exist
--
-- Use a trick: if strips_old_guard is empty, run the migration
--
-- 1. Rename old table
-- 2. Create new table
-- 3. Copy data
-- 4. Drop old table

-- The following statements are wrapped in a transaction and only run if strips_old does not exist
BEGIN;
INSERT INTO strips_old_guard SELECT 1 WHERE (SELECT COUNT(*) FROM strips_old_guard) = 0;
-- If guard is still empty, run migration
DELETE FROM strips_old_guard WHERE (SELECT COUNT(*) FROM strips_old_guard) > 0;
--
-- Only run if guard is empty
--
ALTER TABLE strips RENAME TO strips_old;
CREATE TABLE strips (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  strip_number INTEGER NOT NULL UNIQUE,
  name         TEXT,
  status       TEXT NOT NULL DEFAULT 'idle'
);
INSERT INTO strips (strip_number, name, status)
SELECT 
  CASE 
    WHEN name GLOB '*[0-9][0-9][0-9]' THEN CAST(substr(name, -3) AS INTEGER)
    ELSE NULL
  END AS strip_number,
  name,
  status
FROM strips_old;
DROP TABLE strips_old;
COMMIT;

DROP TABLE IF EXISTS strips_old_guard;
PRAGMA foreign_keys=on;
