<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phase — Atlas</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/bouts-table.css">
</head>

<body>
    <header>
        <strong>Atlas</strong>
        <a href="/">Home</a>
        <a href="/competitions">Competitions</a>
        <a href="/competitions/<%= comp_id %>">Competition</a>
        <span style="margin-left:auto;opacity:.7;font-size:.9rem">Phase <%= phase.phase_order %></span>
    </header>
    <main>

        <div class="pools-grid">
            <% if (phase.pools && phase.pools.length> 0) { %>
                <% phase.pools.forEach(function(pool) { %>
                    <div class="pool-card">
                        <h4>Pool <%= pool.pool_number %>
                        </h4>
                        <div style="overflow-x:auto;margin-bottom:0.5em">
                            <table class="bouts-table" style="font-size:0.95em;min-width:400px">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <% pool.fencers.forEach(function(f, idx) { %>
                                            <th>
                                                <%= idx + 1 %>
                                            </th>
                                            <% }); %>
                                                <th>V</th>
                                                <th>Ind</th>
                                                <th>Sc</th>
                                                <th>Rc</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% pool.fencers.forEach(function(f, i) { %>
                                        <tr>
                                            <th style="text-align:left">
                                                <%= f.name %>
                                            </th>
                                            <th>
                                                <%= i + 1 %>
                                            </th>
                                            <% pool.fencers.forEach(function(_, j) { %>
                                                <% if (i===j) { %>
                                                    <td class="diagonal"></td>
                                                    <% } else { %>
                                                        <% var cell=pool.grid[i][j]; var swapped=false; if (!(cell &&
                                                            cell.left_score !=null && cell.right_score !=null)) {
                                                            cell=pool.grid[j][i]; swapped=true; } %>
                                                            <td style="text-align:center">
                                                                <% if (cell && cell.left_score !=null &&
                                                                    cell.right_score !=null) { %>
                                                                    <% if (!swapped) { %>
                                                                        <% if (cell.winner_id===pool.fencers[i].id) { %>
                                                                            <span
                                                                                style="color:green;font-weight:bold">V</span>
                                                                            <%= cell.left_score %>
                                                                                <% } else { %>
                                                                                    <%= cell.left_score %>
                                                                                        <% } %>
                                                                                            <% } else { %>
                                                                                                <% if
                                                                                                    (cell.winner_id===pool.fencers[i].id)
                                                                                                    { %>
                                                                                                    <span
                                                                                                        style="color:green;font-weight:bold">V</span>
                                                                                                    <%= cell.right_score
                                                                                                        %>
                                                                                                        <% } else { %>
                                                                                                            <%= cell.right_score
                                                                                                                %>
                                                                                                                <% } %>
                                                                                                                    <% }
                                                                                                                        %>
                                                                                                                        <% }
                                                                                                                            %>
                                                            </td>
                                                            <% } %>
                                                                <% }); %>
                                                                    <% var stat=pool.stats[i]; %>
                                                                        <td>
                                                                            <%= stat.victories %>
                                                                        </td>
                                                                        <td>
                                                                            <%= stat.indicator %>
                                                                        </td>
                                                                        <td>
                                                                            <%= stat.scored %>
                                                                        </td>
                                                                        <td>
                                                                            <%= stat.received %>
                                                                        </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <form class="assign-strip-form" data-pool-id="<%= pool.id %>"
                            style="margin-bottom:0.5em;display:inline-block">
                            <label style="font-size:0.95em;margin-right:0.5em;">
                                Assign strip:
                                <select name="strip_id">
                                    <option value="">-- Select --</option>
                                    <% strips.forEach(function(strip) { %>
                                        <option value="<%= strip.id %>" <%=pool.strip_id===strip.id ? 'selected' : '' %>
                                            >
                                            <%= strip.name || ('Piste ' + strip.strip_number) %> [<%= strip.state %>, <%= strip.network_state %>]
                                        </option>
                                    <% }); %>
                                </select>
                            </label>
                            <button type="submit">Assign</button>
                        </form>
                        <a href="/competitions/<%= comp_id %>/phases/<%= phase.id %>/pools/<%= pool.id %>/view"
                            class="primary" style="margin-bottom:0.5em;display:inline-block">Enter results for this
                            pool</a>
                    <script>
                        // Assign strip to pool via AJAX
                        document.querySelectorAll(' .assign-strip-form').forEach(form => {
                            form.addEventListener('submit', async function (e) {
                                e.preventDefault();
                                const poolId = form.getAttribute('data-pool-id');
                                const stripId = form.strip_id.value;
                                // Use the correct API endpoint
                                const compId = '<%= compId %>';
                                const phaseId = '<%= phase.id %>';
                                const apiUrl =
                                    `/api/competitions/${compId}/phases/${phaseId}/pools/${poolId}/assign-strip`;
                                const res = await fetch(apiUrl, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ strip_id: stripId || null })
                                });
                                if (res.ok) {
                                    window.location.reload();
                                } else {
                                    alert('Failed to assign strip.');
                                }
                            });
                        });
                    </script>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <p>No pools available.</p>
                            <% } %>
        </div>


        <div class="card">
            <h3>Ranking after pools</h3>
            <% if (typeof rankings !=='undefined' && rankings.length> 0) { %>
                <table class="bouts-table" style="margin-bottom:1.5em">
                    <thead>
                        <tr>
                            <th>Pos</th>
                            <th>Name</th>
                            <th>Victories</th>
                            <th>Matches</th>
                            <th>Victory %</th>
                            <th>Indicator</th>
                            <th>Scored</th>
                            <th>Received</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rankings.forEach(function(r) { %>
                            <tr>
                                <td>
                                    <%= r.position %>
                                </td>
                                <td>
                                    <%= r.name %>
                                </td>
                                <td>
                                    <%= r.victories %>
                                </td>
                                <td>
                                    <%= r.matches %>
                                </td>
                                <td>
                                    <%= r.matches> 0 ? (r.victory_ratio*100).toFixed(1) : '0.0' %>%
                                </td>
                                <td>
                                    <%= r.indicator %>
                                </td>
                                <td>
                                    <%= r.touches_scored %>
                                </td>
                                <td>
                                    <%= r.touches_received %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
                <% } else { %>
                    <p>No results yet.</p>
                    <% } %>
        </div>
    </main>
</body>

</html>