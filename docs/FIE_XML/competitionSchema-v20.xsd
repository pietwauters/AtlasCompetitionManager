<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
	<xs:simpleType name="Domaine">
		<xs:restriction base="xs:string">
			<xs:enumeration value="I"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="R"/>
			<xs:enumeration value="L"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="Z"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Arme">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E"/>
			<xs:enumeration value="F"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="X"/>
			<xs:enumeration value="M"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Classe">
		<xs:restriction base="xs:string">
			<xs:enumeration value="A"/>
			<xs:enumeration value="B"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="Open"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Heure">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9][0-9]:[0-9][0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Lateralite">
		<xs:restriction base="xs:string">
			<xs:enumeration value="G"/>
			<xs:enumeration value="D"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RoleArbitre">
		<xs:restriction base="xs:string">
			<xs:enumeration value="P"/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="V"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RoleOfficiel">
		<xs:restriction base="xs:string">
			<xs:enumeration value="DT"/>
			<xs:enumeration value="DA"/>
			<xs:enumeration value="S"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sexe">
		<xs:restriction base="xs:string">
			<xs:enumeration value="F"/>
			<xs:enumeration value="M"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SexeCompetition">
		<xs:restriction base="xs:string">
			<xs:enumeration value="F"/>
			<xs:enumeration value="M"/>
			<xs:enumeration value="X"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Statut">
		<xs:restriction base="xs:string">
			<xs:enumeration value="V"/>
			<xs:enumeration value="D"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="Q"/>
			<xs:enumeration value="X"/>
			<xs:enumeration value="DNF"/>
			<xs:enumeration value="DNS"/>
			<xs:enumeration value="MED"/>
			<xs:enumeration value="EXC"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TypeCompetition">
		<xs:restriction base="xs:string">
			<xs:enumeration value="S"/>
			<xs:enumeration value="I"/>
			<xs:enumeration value="V"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Deroulement">
		<xs:restriction base="xs:string">
			<xs:enumeration value="P"/>
			<xs:enumeration value="R"/>
			<xs:enumeration value="L"/>
			<xs:enumeration value="F"/>
			<xs:enumeration value="O"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:attributeGroup name="attributsTireurPoule">
		<xs:attribute name="NbMatches" type="xs:integer"/>
		<xs:attribute name="NbVictoires" type="xs:integer"/>
		<xs:attribute name="NoDansLaPoule" type="xs:integer"/>
        <xs:attribute name="RangPoule">
    			<xs:simpleType>
        		<xs:restriction base="xs:string">
            	<xs:pattern value="\d*"/>
        		</xs:restriction>
    			</xs:simpleType>
			</xs:attribute>
		<xs:attribute name="TD" type="xs:integer"/>
		<xs:attribute name="TR" type="xs:integer"/>
	</xs:attributeGroup>
	<xs:element name="Tireur">
		<xs:complexType>
			<xs:attribute name="Arme" type="xs:string"/>
			<xs:attribute name="CartonJaune" type="xs:integer"/>
			<xs:attribute name="CartonRouge" type="xs:integer"/>
			<xs:attribute name="Classement" type="xs:integer"/>
			<xs:attribute name="ClassementFusionne" type="xs:integer"/>
			<xs:attribute name="Club" type="xs:string"/>
			<xs:attribute name="Cote" type="Lateralite"/>
			<xs:attribute name="DateNaissance" type="xs:string"/>
			<xs:attribute name="DemandeVideoRejetee" type="xs:integer"/>
			<xs:attribute name="Dossard" type="xs:string"/>
			<xs:attribute name="Equipe" type="xs:string"/>
			<xs:attribute name="ID" type="xs:string"/>
			<xs:attribute name="Lateralite" type="Lateralite"/>
			<xs:attribute name="Licence" type="xs:string"/>
			<xs:attribute name="LicenceNat" type="xs:string"/>
			<xs:attribute name="Ligue" type="xs:string"/>
			<xs:attribute name="Nation" type="xs:string"/>
			<xs:attribute name="Nom" type="xs:string"/>
			<xs:attribute name="PhotoURL" type="xs:string"/>
			<xs:attribute name="Prenom" type="xs:string"/>
			<xs:attribute name="Points" type="xs:string"/>
			<xs:attribute name="REF" type="xs:string"/>
			<xs:attribute name="RangFinal" type="xs:integer"/>
			<xs:attribute name="RangInitial" type="xs:integer"/>
			<xs:attribute name="Score">
    			<xs:simpleType>
        		<xs:restriction base="xs:string">
            	<xs:pattern value="\d*"/>
        		</xs:restriction>
    			</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Sexe" type="xs:string"/>
			<xs:attribute name="Statut" type="xs:string"/>
			<xs:attributeGroup ref="attributsTireurPoule"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Assaut">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireur" minOccurs="0" maxOccurs="2"/>
			</xs:sequence>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="Statut" type="Deroulement"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Tireurs">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Equipe">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Classement" type="xs:integer"/>
			<xs:attribute name="ClassementFusionne" type="xs:integer"/>
			<xs:attribute name="Club" type="xs:string"/>
			<xs:attribute name="ID" type="xs:string"/>
			<xs:attribute name="Ligue" type="xs:string"/>
			<xs:attribute name="Nation" type="xs:string"/>
			<xs:attribute name="Nom" type="xs:string"/>
			<xs:attribute name="Points" type="xs:string"/>
			<xs:attribute name="REF" type="xs:string"/>
			<xs:attribute name="RangFinal" type="xs:integer"/>
			<xs:attribute name="RangInitial" type="xs:integer"/>
			<xs:attribute name="Score">
    			<xs:simpleType>
        		<xs:restriction base="xs:string">
            	<xs:pattern value="\d*"/>
        		</xs:restriction>
    			</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Statut" type="Statut"/>
			<xs:attributeGroup ref="attributsTireurPoule"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Equipes">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Equipe" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Match">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Arbitre" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Equipe" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Assaut" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Date" type="xs:string"/>
			<xs:attribute name="Heure" type="Heure"/>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="Piste" type="xs:string"/>
			<xs:attribute name="Statut" type="Deroulement"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Arbitre">
		<xs:complexType>
			<xs:attribute name="Categorie" type="xs:string"/>
			<xs:attribute name="CategorieEpee" type="xs:string"/>
			<xs:attribute name="CategorieFleuret" type="xs:string"/>
			<xs:attribute name="CategorieSabre" type="xs:string"/>
			<xs:attribute name="Club" type="xs:string"/>
			<xs:attribute name="DateNaissance" type="xs:string"/>
			<xs:attribute name="ID" type="xs:string"/>
			<xs:attribute name="IDTournoi" type="xs:string"/>
			<xs:attribute name="Licence" type="xs:string"/>
			<xs:attribute name="Ligue" type="xs:string"/>
			<xs:attribute name="Nation" type="xs:string"/>
			<xs:attribute name="Nom" type="xs:string"/>
			<xs:attribute name="Prenom" type="xs:string"/>
			<xs:attribute name="REF" type="xs:string"/>
			<xs:attribute name="Role" type="RoleArbitre"/>
			<xs:attribute name="Sexe" type="Sexe"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Officiel">
		<xs:complexType>
			<xs:attribute name="IDTournoi" type="xs:string"/>
			<xs:attribute name="Nation" type="xs:string"/>
			<xs:attribute name="Nom" type="xs:string"/>
			<xs:attribute name="Prenom" type="xs:string"/>
			<xs:attribute name="Role" type="RoleOfficiel"/>
			<xs:attribute name="Sexe" type="Sexe"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Arbitres">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Arbitre" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Officiels">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Officiel" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Poule">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Arbitre" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Match" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Date" type="xs:string"/>
			<xs:attribute name="Heure" type="Heure"/>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="Piste" type="xs:string"/>
			<xs:attribute name="Statut" type="Deroulement"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Tableau">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Match" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="Taille" type="xs:integer" use="required"/>
			<xs:attribute name="Titre" type="xs:string" use="required"/>
			<xs:attribute name="DestinationDesElimines" type="xs:string"/>
			<xs:attribute name="Statut" type="Deroulement"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="SuiteDeTableaux">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tableau" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="Lettre" type="xs:string"/>
			<xs:attribute name="NbDeTableaux" type="xs:integer" use="required"/>
			<xs:attribute name="Titre" type="xs:string" use="required"/>
			<xs:attribute name="DestinationDesQualifies" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MatchesDeBarrage">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Match" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="NbDeMatches" type="xs:integer" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="PhaseDeTableaux">
		<xs:complexType>
			<xs:sequence>
				<xs:choice minOccurs="0">
					<xs:element ref="Equipe" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
				</xs:choice>
				<xs:element ref="SuiteDeTableaux" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="NbExemptes" type="xs:integer"/>
			<xs:attribute name="PhaseID" type="xs:string" use="required"/>
			<xs:attribute name="PhaseSuivanteDesQualifies" type="xs:string"/>
			<xs:attribute name="PhaseSuivanteDesElimines" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TourDePoules">
		<xs:complexType>
			<xs:sequence>
				<xs:choice minOccurs="0">
					<xs:element ref="Equipe" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="Tireur" minOccurs="0" maxOccurs="unbounded"/>
				</xs:choice>
				<xs:element ref="Poule" maxOccurs="unbounded"/>
				<xs:element ref="MatchesDeBarrage" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="ID" type="xs:string" use="required"/>
			<xs:attribute name="NbDePoules" type="xs:integer" use="required"/>
			<xs:attribute name="NbExemptes" type="xs:integer"/>
			<xs:attribute name="NbQualifiesParIndice" type="xs:integer" use="required"/>
			<xs:attribute name="NbQualifiesParPoule" type="xs:integer" use="required"/>
			<xs:attribute name="PhaseID" type="xs:string" use="required"/>
			<xs:attribute name="PhaseSuivanteDesQualifies" type="xs:string"/>
			<xs:attribute name="PhaseSuivanteDesElimines" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Phases">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element ref="PhaseDeTableaux"/>
				<xs:element ref="TourDePoules"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:attributeGroup name="attributsCompetition">
		<xs:attribute name="Annee" type="xs:string" use="required"/>
		<xs:attribute name="Arme" type="Arme" use="required"/>
		<xs:attribute name="Categorie" type="xs:string" use="required"/>
		<xs:attribute name="Championnat" type="xs:string"/>
		<xs:attribute name="Classe" type="Classe" />
		<xs:attribute name="Date" type="xs:string"/>
		<xs:attribute name="DateDebut" type="xs:string"/>
		<xs:attribute name="DateFichierXML" type="xs:string"/>
		<xs:attribute name="DateFin" type="xs:string"/>
		<xs:attribute name="Domaine" type="Domaine" use="required"/>
		<xs:attribute name="Federation" type="xs:string"/>
		<xs:attribute name="ID" type="xs:string" use="required"/>
		<xs:attribute name="IDTournoi" type="xs:string"/>
		<xs:attribute name="Lieu" type="xs:string" use="optional"/>
		<xs:attribute name="LiveURL" type="xs:string" use="optional"/>
		<xs:attribute name="Organisateur" type="xs:string"/>
		<xs:attribute name="Sexe" type="SexeCompetition" use="required"/>
		<xs:attribute name="Titre1" type="xs:string" use="optional"/>
		<xs:attribute name="Titre2" type="xs:string" use="optional"/>
		<xs:attribute name="Titre3" type="xs:string" use="optional"/>
		<xs:attribute name="Titre4" type="xs:string" use="optional"/>
		<xs:attribute name="TitreCourt" type="xs:string" use="optional"/>
		<xs:attribute name="TitreCourtTournoi" type="xs:string" use="optional"/>
		<xs:attribute name="TitreLong" type="xs:string" use="optional"/>
		<xs:attribute name="TitreLongTournoi" type="xs:string" use="optional"/>
		<xs:attribute name="URLorganisateur" type="xs:string" use="optional"/>
		<xs:attribute name="Version" type="xs:string" use="required"/>
		<xs:attribute name="VideoURL" type="xs:string" use="optional"/>
		<xs:attribute name="ZoneHoraire" type="xs:string" use="optional"/>
	</xs:attributeGroup>
	<xs:element name="BaseCompetitionIndividuelle">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireurs"/>
				<xs:element ref="Arbitres"/>
				<xs:element ref="Officiels" minOccurs="0"/>
			</xs:sequence>
			<xs:attributeGroup ref="attributsCompetition"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="BaseCompetitionParEquipes">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireurs"/>
				<xs:element ref="Arbitres"/>
				<xs:element ref="Equipes"/>
				<xs:element ref="Officiels" minOccurs="0"/>
			</xs:sequence>
			<xs:attributeGroup ref="attributsCompetition"/>
			<xs:attribute name="TypeCompetition" type="TypeCompetition"/>
			<xs:attribute name="TailleEquipe" type="xs:integer"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CompetitionIndividuelle">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tireurs"/>
				<xs:element ref="Arbitres"/>
				<xs:element ref="Phases"/>
				<xs:element ref="Officiels" minOccurs="0"/>
			</xs:sequence>
			<xs:attributeGroup ref="attributsCompetition"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CompetitionParEquipes">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Equipes"/>
				<xs:element ref="Arbitres"/>
				<xs:element ref="Phases"/>
				<xs:element ref="Officiels" minOccurs="0"/>
			</xs:sequence>
			<xs:attributeGroup ref="attributsCompetition"/>
			<xs:attribute name="TailleEquipe" type="xs:integer"/>
			<xs:attribute name="TypeCompetition" type="TypeCompetition"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
